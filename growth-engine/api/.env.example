# growth-api configuration. Copy to .env for local runs; in production set these as host/Supabase secrets.
# Never commit real values.

# Postgres connection for the least-privileged API user (member of growth_intake). See docs/setup.md step 3.
DATABASE_URL=postgres://growth_api:CHANGE_ME@db.<project-ref>.supabase.co:5432/postgres

# Browser origins allowed to POST leads (comma-separated, exact origins, no paths).
ALLOWED_ORIGINS=https://flowpilot-rob9iwxx.manus.space
# Your own domains (referrals from these count as "direct").
OWN_DOMAINS=flowpilot-rob9iwxx.manus.space

# 32+ random characters each:  openssl rand -base64 48
IP_HASH_SALT=
UNSUBSCRIBE_SECRET=

CONTACT_EMAIL=stellanrowbotham@gmail.com
# true = every record is marked is_test (staging / demos)
GROWTH_TEST_MODE=false

# Optional
# BASE_PATH=/growth-api                 # set automatically on Supabase Edge Functions
# TRUST_PROXY=true                      # behind a proxy that sets X-Forwarded-For (Render, Fly, Railway)
# LEAD_LIMIT_PER_IP_PER_HOUR=5
# LEAD_LIMIT_GLOBAL_PER_HOUR=200
# PORT=8787
