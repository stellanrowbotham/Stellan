    {
      "id": "9bd3a3f0-988f-43e3-8428-5b534142c3e8",
      "name": "Plan sending batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        1200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const S = {};\nfor (const i of $('Load settings').all()) { if (i.json.key) { let v = String(i.json.value == null ? '' : i.json.value).trim(); if (/^(true|false)$/i.test(v)) v = v.toLowerCase(); S[String(i.json.key).trim()] = v; } }\nlet trig = 'unknown';\nfor (const n of ['Weekdays 10:15', 'Weekdays 13:15', 'Run now']) { try { if ($(n).isExecuted) { trig = n; break; } } catch (e) {} }\nconst exec = $execution.id;\nconst halt = reason => [{ json: { action: 'halt', reason: reason, trigger: trig } }];\nconst now = $now.setZone('America/Toronto');\nconst leads = $('Load leads').all().map(i => i.json).filter(r => r && r.id);\nconst sup = $('Load suppression').all().map(i => i.json);\nconst supEmails = new Set(sup.map(s => String(s.email || '').trim().toLowerCase()).filter(Boolean));\nconst supDomains = new Set(sup.map(s => String(s.domain || '').trim().toLowerCase()).filter(Boolean));\nconst up = s => String(s || '').toUpperCase();\nconst out = [];\nfor (const r of leads) { if (up(r.status) === 'SENDING' && r.claimed_at && now.diff(DateTime.fromISO(r.claimed_at), 'minutes').minutes > 15) out.push({ json: { action: 'stale', lead_id: r.id, claim_token: r.claim_token || '', trigger: trig, reason: 'Send outcome unknown (row stuck in SENDING since ' + r.claimed_at + '). Check the Gmail Sent folder before re-approving.' } }); }\nif (S.paused === 'true') return out.length ? out : halt('paused');\nif (up(S.send_mode) !== 'SEND') return out.length ? out : halt('send_mode is ' + (S.send_mode || 'unset') + ': nothing is sent automatically');\nif (now.weekday > 5 || now.hour < 8 || now.hour >= 18) return out.length ? out : halt('outside sending hours (weekdays 8:00-18:00 Toronto)');\nconst bounceLimit = parseInt(S.bounce_pause_threshold || '2', 10);\nconst bounces = leads.filter(r => up(r.status) === 'BOUNCED' && r.last_status_at && now.diff(DateTime.fromISO(r.last_status_at), 'days').days <= 7).length;\nif (bounces >= bounceLimit) return out.length ? out : halt('auto-paused: ' + bounces + ' bounces in the last 7 days (threshold ' + bounceLimit + ')');\nconst startOfDay = now.startOf('day');\nconst sentToday = leads.filter(r => r.sent_at && DateTime.fromISO(r.sent_at) >= startOfDay).length;\nconst inFlight = leads.filter(r => up(r.status) === 'SENDING').length;\nconst daily = parseInt(S.daily_send_limit || '6', 10);\nconst perWindow = parseInt(S.batch_size_per_window || '3', 10);\nlet room = Math.max(0, Math.min(perWindow, daily - sentToday - inFlight));\n// n8n stops a run after 180 s: keep sends x spacing well under that so no row is left in SENDING.\nconst spacingSec = Math.max(0, parseInt(S.spacing_seconds || '20', 10) || 0);\nroom = Math.min(room, Math.max(1, Math.floor(120 / (spacingSec + 8))));\nconst EMAIL_RE = /^[^\\s@]+@([^\\s@]+\\.[a-z]{2,})$/i;\nfunction addBusinessDays(dt, n) { let d = dt; let added = 0; while (added < n) { d = d.plus({ days: 1 }); if (d.weekday <= 5) added++; } return d.set({ hour: 9, minute: 30, second: 0, millisecond: 0 }); }\nconst fu1 = parseInt(S.followup_1_business_days || '4', 10);\nfunction checks(subject, body) {\n  const o = []; const words = body.split(/\\s+/).filter(Boolean).length;\n  if (words < 40 || words > 170) o.push('body is ' + words + ' words');\n  if (/https?:\\/\\/|www\\./i.test(body)) o.push('body contains a link');\n  if (!/Stellan Rowbotham/.test(body)) o.push('signature missing');\n  if (/^(re|fwd?):/i.test(subject.trim()) || !subject.trim()) o.push('subject missing or misleading');\n  const money = body.match(/\\$\\s?\\d[\\d,]*/g) || [];\n  for (const mm of money) { if (!['$300','$600','$1,000','$1000','$149'].includes(mm.replace(/\\s/g, ''))) o.push('unapproved money figure ' + mm); }\n  if (/guarantee|testimonial|case stud|our clients/i.test(body)) o.push('unsupported-claim wording');\n  return o;\n}\nconst seen = new Set();\nconst approved = leads.filter(r => up(r.status) === 'APPROVED').sort((a, b) => (Number(b.score) || 0) - (Number(a.score) || 0));\nfor (const r of approved) {\n  const email = String(r.public_email || '').trim().toLowerCase();\n  const m = email.match(EMAIL_RE);\n  let reason = ''; let next = 'SKIPPED';\n  const subject = String(r.email_subject || ''); const body = String(r.email_body || '');\n  if (!r.business_name || !subject || !body || !email) { reason = 'Missing required field (business name, email, subject or body).'; next = 'NEEDS_REVIEW'; }\n  else if (!m) { reason = 'Email address syntax is not valid.'; }\n  else if (r.gmail_message_id || r.sent_at) { reason = 'Already contacted (a first-contact email was sent before).'; }\n  else if (leads.some(o => o.id !== r.id && String(o.public_email || '').trim().toLowerCase() === email && (o.gmail_message_id || o.sent_at || ['SENDING','SENT'].includes(up(o.status))))) { reason = 'Duplicate: this address was already contacted through another lead.'; }\n  else if (seen.has(email)) { reason = 'Same address twice in this batch.'; }\n  else if (supEmails.has(email) || supDomains.has(m[1])) { reason = 'Address or domain is on the suppression list.'; next = 'SUPPRESSED'; }\n  else if (r.no_solicitation_notice === true) { reason = 'Website asks not to be solicited.'; next = 'SUPPRESSED'; }\n  else if (!r.contact_basis || !r.contact_basis_evidence) { reason = 'Contact basis or its evidence is not recorded; compliance uncertain.'; next = 'NEEDS_REVIEW'; }\n  else if (!['APPROVE', 'HUMAN_APPROVED'].includes(up(r.ai_decision))) { reason = 'Email was not approved by the AI critic. Edit it and set ai_decision to HUMAN_APPROVED to send anyway.'; next = 'NEEDS_REVIEW'; }\n  else { const c = checks(subject, body); if (c.length) { reason = 'Email failed final checks: ' + c.join('; '); next = 'NEEDS_REVIEW'; } }\n  if (reason) { out.push({ json: { action: 'skip', lead_id: r.id, next_status: next, reason: reason, trigger: trig } }); continue; }\n  if (room <= 0) continue;\n  room--; seen.add(email);\n  out.push({ json: { action: 'send', lead_id: r.id, claim_token: exec + '-' + r.id, to: email, domain: m[1], subject: subject.trim(), body: body.trim(), draft_id: r.gmail_draft_id || '', campaign_id: r.campaign_id || S.campaign_id || '', followup_at: addBusinessDays(now, fu1).toISO(), dry_run: S.dry_run === 'true', spacing: spacingSec, trigger: trig } });\n}\nif (!out.length) return halt(approved.length ? 'daily or per-window limit reached (' + sentToday + ' sent today)' : 'no APPROVED leads');\nreturn out;\n"
      }
    },
