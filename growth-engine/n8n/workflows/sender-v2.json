    {
      "id": "5cfdb70a-156d-4403-9730-1420ad7915ac",
      "name": "Classify MX result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        432
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json || {};\nlet result = 'transient'; let detail = '';\nif (j.error) { detail = 'DNS lookup request failed (temporary): ' + String(j.error.message || j.error).slice(0, 200); }\nelse if (j.Status === 0) {\n  const mx = (j.Answer || []).filter(a => a.type === 15);\n  const nullMx = mx.length === 1 && /^0\\s+\\.$/.test(String(mx[0].data || '').trim());\n  if (mx.length && !nullMx) { result = 'ok'; detail = 'MX found: ' + mx.map(a => a.data).slice(0, 2).join(', '); }\n  else if (nullMx) { result = 'invalid'; detail = 'Domain publishes a null MX: it does not accept email.'; }\n  else { result = 'invalid'; detail = 'Domain exists but publishes no MX record (confirmed by DNS).'; }\n}\nelse if (j.Status === 3) { result = 'invalid'; detail = 'Domain does not exist (NXDOMAIN, confirmed by DNS).'; }\nelse { detail = 'DNS answered with status ' + j.Status + ' (temporary); released back to APPROVED for the next window.'; }\nreturn [{ json: { mx_result: result, mx_detail: detail } }];\n"
      }
    },
