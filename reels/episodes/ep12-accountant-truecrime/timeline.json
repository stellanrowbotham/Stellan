{"dur": 35.5, "title": 0.3, "spin": [6.0, 14.2], "bot": 14.9, "logo": 25.4, "captions": [{"t0": 0.6, "t1": 2.347, "text": "March. Tax season.", "who": "narrator"}, {"t0": 2.347, "t1": 4.191, "text": "And the receipts...", "who": "narrator"}, {"t0": 4.191, "t1": 5.161, "text": "were gone.", "who": "narrator"}, {"t0": 5.9, "t1": 6.798, "text": "For weeks,", "who": "narrator"}, {"t0": 6.798, "t1": 9.042, "text": "the accountant chased the", "who": "narrator"}, {"t0": 9.042, "t1": 10.21, "text": "same clients.", "who": "narrator"}, {"t0": 10.21, "t1": 11.466, "text": "Emails. Calls.", "who": "narrator"}, {"t0": 11.466, "t1": 12.634, "text": "Sticky notes.", "who": "narrator"}, {"t0": 12.634, "t1": 14.25, "text": "Nothing came back.", "who": "narrator"}, {"t0": 14.9, "t1": 16.395, "text": "Then a new detective", "who": "narrator"}, {"t0": 16.395, "t1": 17.441, "text": "took the case.", "who": "narrator"}, {"t0": 17.441, "t1": 18.562, "text": "A bot that asks", "who": "narrator"}, {"t0": 18.562, "t1": 19.982, "text": "for every document,", "who": "narrator"}, {"t0": 19.982, "t1": 21.701, "text": "sends polite reminders,", "who": "narrator"}, {"t0": 21.701, "t1": 22.897, "text": "and files it all", "who": "narrator"}, {"t0": 22.897, "t1": 23.943, "text": "in one folder.", "who": "narrator"}, {"t0": 23.943, "t1": 24.84, "text": "Case closed.", "who": "narrator"}, {"t0": 25.55, "t1": 26.901, "text": "This is your FlowPilot", "who": "pilot"}, {"t0": 26.901, "t1": 28.865, "text": "speaking. Document collection on", "who": "pilot"}, {"t0": 28.865, "t1": 30.154, "text": "autopilot. DM us DOCS", "who": "pilot"}, {"t0": 30.154, "t1": 31.566, "text": "for the free checklist.", "who": "pilot"}, {"t0": 31.566, "t1": 33.101, "text": "You're still the captain.", "who": "pilot"}], "voice": [{"t0": 0.6, "t1": 5.161, "who": "narrator"}, {"t0": 5.9, "t1": 14.25, "who": "narrator"}, {"t0": 14.9, "t1": 24.84, "who": "narrator"}, {"t0": 25.55, "t1": 33.101, "who": "pilot"}]}