{"dur": 36.5, "race": 7.0, "inquiry": 9.2, "bstart": 10.8, "reply": 14.0, "bfinish": 15.2, "booked": 19.6, "forecast": 22.4, "logo": 26.6, "captions": [{"t0": 0.5, "t1": 1.539, "text": "Good evening!", "who": "anchor"}, {"t0": 1.539, "t1": 2.657, "text": "A big storm is", "who": "anchor"}, {"t0": 2.657, "t1": 4.175, "text": "rolling in tonight,", "who": "anchor"}, {"t0": 4.175, "t1": 5.932, "text": "with leads arriving at", "who": "anchor"}, {"t0": 5.932, "t1": 6.571, "text": "90 km/h.", "who": "anchor"}, {"t0": 7.2, "t1": 8.605, "text": "Here comes a roof", "who": "anchor"}, {"t0": 8.605, "t1": 9.679, "text": "leak inquiry.", "who": "anchor"}, {"t0": 9.679, "t1": 10.836, "text": "Roofer A is up", "who": "anchor"}, {"t0": 10.836, "t1": 11.827, "text": "on a ladder.", "who": "anchor"}, {"t0": 11.827, "t1": 12.984, "text": "Roofer B has a", "who": "anchor"}, {"t0": 12.984, "t1": 13.315, "text": "bot.", "who": "anchor"}, {"t0": 14.0, "t1": 15.283, "text": "Sorry about the leak!", "who": "pilot"}, {"t0": 15.283, "t1": 16.138, "text": "Can you send a", "who": "pilot"}, {"t0": 16.138, "t1": 17.177, "text": "photo? We have an", "who": "pilot"}, {"t0": 17.177, "t1": 18.826, "text": "inspection slot tomorrow at", "who": "pilot"}, {"t0": 18.826, "t1": 18.949, "text": "9.", "who": "pilot"}, {"t0": 19.6, "t1": 20.901, "text": "And Roofer B gets", "who": "anchor"}, {"t0": 20.901, "t1": 21.819, "text": "the booking!", "who": "anchor"}, {"t0": 21.819, "t1": 24.038, "text": "Tonight's forecast: the first", "who": "anchor"}, {"t0": 24.038, "t1": 25.492, "text": "to reply often gets", "who": "anchor"}, {"t0": 25.492, "t1": 26.104, "text": "the job.", "who": "anchor"}, {"t0": 27.5, "t1": 28.884, "text": "This is your FlowPilot", "who": "pilot"}, {"t0": 28.884, "t1": 30.96, "text": "speaking. Get storm-season ready.", "who": "pilot"}, {"t0": 30.96, "t1": 32.344, "text": "Comment ROOF and we'll", "who": "pilot"}, {"t0": 32.344, "t1": 33.162, "text": "show you how.", "who": "pilot"}, {"t0": 33.162, "t1": 34.734, "text": "You're still the captain.", "who": "pilot"}], "voice": [{"t0": 0.5, "t1": 6.571, "who": "anchor"}, {"t0": 7.2, "t1": 13.315, "who": "anchor"}, {"t0": 14.0, "t1": 18.949, "who": "pilot"}, {"t0": 19.6, "t1": 26.104, "who": "anchor"}, {"t0": 27.5, "t1": 34.734, "who": "pilot"}]}