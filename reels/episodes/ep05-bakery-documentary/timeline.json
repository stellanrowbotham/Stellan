{"dur": 33.6, "flock": 7.6, "print": 16.1, "tickets": [17.6, 19.3, 21.0], "logo": 24.5, "captions": [{"t0": 0.5, "t1": 1.957, "text": "Here we observe the", "who": "narrator"}, {"t0": 1.957, "t1": 3.721, "text": "baker... in her natural", "who": "narrator"}, {"t0": 3.721, "t1": 5.101, "text": "habitat. Rising...", "who": "narrator"}, {"t0": 5.101, "t1": 6.941, "text": "before the bread itself.", "who": "narrator"}, {"t0": 7.3, "t1": 8.944, "text": "But the orders...", "who": "narrator"}, {"t0": 8.944, "t1": 10.491, "text": "arrive at night.", "who": "narrator"}, {"t0": 10.491, "t1": 11.264, "text": "By text.", "who": "narrator"}, {"t0": 11.264, "t1": 11.844, "text": "By DM.", "who": "narrator"}, {"t0": 11.844, "t1": 13.681, "text": "An endless flock of", "who": "narrator"}, {"t0": 13.681, "t1": 14.841, "text": "\"can I get a", "who": "narrator"}, {"t0": 14.841, "t1": 15.518, "text": "dozen?\"", "who": "narrator"}, {"t0": 16.0, "t1": 16.77, "text": "And yet...", "who": "narrator"}, {"t0": 16.77, "t1": 18.541, "text": "the pre-order bot takes", "who": "narrator"}, {"t0": 18.541, "t1": 19.234, "text": "each one,", "who": "narrator"}, {"t0": 19.234, "t1": 20.62, "text": "prints the ticket,", "who": "narrator"}, {"t0": 20.62, "t1": 22.161, "text": "and sends the pickup", "who": "narrator"}, {"t0": 22.161, "t1": 23.778, "text": "reminder. Remarkable.", "who": "narrator"}, {"t0": 24.8, "t1": 26.266, "text": "This is your FlowPilot", "who": "pilot"}, {"t0": 26.266, "t1": 27.665, "text": "speaking. Pre-orders,", "who": "pilot"}, {"t0": 27.665, "t1": 29.197, "text": "sorted while you sleep.", "who": "pilot"}, {"t0": 29.197, "t1": 30.13, "text": "DM us the word", "who": "pilot"}, {"t0": 30.13, "t1": 31.596, "text": "PLAN. You're still the", "who": "pilot"}, {"t0": 31.596, "t1": 32.129, "text": "captain.", "who": "pilot"}], "voice": [{"t0": 0.5, "t1": 6.941, "who": "narrator"}, {"t0": 7.3, "t1": 15.518, "who": "narrator"}, {"t0": 16.0, "t1": 23.778, "who": "narrator"}, {"t0": 2